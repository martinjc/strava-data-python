[Unit]
Description=Strava Data Display Slideshow
After=network.target

[Service]
# User running the script (usually pi)
User=pi
Group=pi

# Path to the project directory
WorkingDirectory=/home/pi/strava-data-python

# Environment variables if needed
# Environment=DISPLAY=:0

# Command to run (using the venv python)
ExecStart=/home/pi/strava-data-python/venv/bin/python display/display_image.py

# Restart config
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
